# Supabase project — copy to .env.local for local development.
#
# Vercel does NOT read this file. Set all four variables manually in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The deployment's own origin, used to build the links in confirmation and
# password-reset emails. Set this to your Vercel domain in production,
# otherwise the emailed link points at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Not read by the application at any point — supabase/seed.sql runs
# in the SQL Editor, which already has its own credentials. Only needed if you
# later write a Node script that talks to the project with admin rights.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Receipt scanning (Google AI Studio key, https://aistudio.google.com/apikey).
# Server-only. Set it in Vercel too. Optional: GEMINI_MODEL (tried first; falls back to gemini-3.5-flash, gemini-3.8-flash).
GEMINI_API_KEY=your-gemini-api-key
